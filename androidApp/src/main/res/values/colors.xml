<?xml version="1.0" encoding="utf-8"?>
<!--
    Acilis penceresinin rengi.

    Compose kendi temasini cizer; buradaki degerler yalniz uygulama daha ilk
    karesini cizmeden once, sistemin gosterdigi pencere icindir.

    ACIK VARSAYILAN: bu dosya acik temanin yuzey rengini tasir, values-night
    koyusunu. Onceden tek bir koyu renk sabit yaziliydi ve uygulamanin varsayilan
    temasi acikti - yani her acilista once koyu bir kare parliyor, hemen ardindan
    ekran acik temaya geciyordu.
-->
<resources>
    <color name="window_background">#FAF7F1</color>
    <color name="splash_background">#FAF7F1</color>

    <!-- Isaretin altini. Acik temada koyu altin okunur, kremde kaybolur. -->
    <color name="brand_mark">#8C5E16</color>

    <!--
        Ana ekran widget'i ve kisayol simgeleri. Uygulamanin acik paleti
        (KefeLightColors); koyusu values-night'ta. Widget sistemin acik/koyu
        secimine uyar - uygulamanin kendi tema secimini ana ekran bilemez.
    -->
    <color name="widget_surface">#FFFFFF</color>
    <color name="widget_outline">#DED6C8</color>
    <color name="widget_sunken">#EFE9DE</color>
    <color name="widget_base">#FAF7F1</color>
    <color name="widget_on_surface">#1C1813</color>
    <color name="widget_muted">#6B6357</color>
    <color name="widget_accent">#8C5E16</color>
    <color name="widget_on_accent">#FFF6E8</color>
    <color name="widget_negative">#B24239</color>
    <color name="widget_cat_gold">#9A7415</color>
    <color name="widget_cat_fx">#2F7565</color>
    <color name="widget_cat_fund">#5257A6</color>
    <color name="widget_cat_stock">#A1466A</color>
    <color name="widget_cat_cash">#9B5B41</color>
    <color name="widget_cat_silver">#5C7284</color>
</resources>
