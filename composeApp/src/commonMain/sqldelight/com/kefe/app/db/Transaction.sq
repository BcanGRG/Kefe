import com.kefe.app.domain.model.SyncState;
import com.kefe.app.domain.model.TradeSide;

-- Islem defteri. Uygulamanin tek gercek kaynagi burasi: pozisyonun miktari da
-- maliyeti de bu satirlardan hesaplanir.
--
-- Tablo adi "transactions" (cogul) - "transaction" SQLite'ta ayrilmis kelime.
--
-- TARIH: KefeDate uc alanli bir deger nesnesi ve TERSI YOK (toEpochDay var,
-- fromEpochDay yok). Tek epochDay kolonu secilse okurken KefeDate uretilemezdi;
-- bu yuzden yil/ay/gun ayri kolonlar. Siralama da (yil, ay, gun) uzerinden
-- dogru calisir.
--
-- Kolonlar duz INTEGER: Kotlin'de Long donerler, KefeDate kurulurken toInt()
-- gerekir. "INTEGER AS Int" daha okunakli olurdu ama ayri bir adaptor
-- bagimliligi (primitive-adapters) ister - bu is icin gereksiz risk.
--
-- total (miktar * fiyat + iscilik) TURETILMIS, kolon degil.
CREATE TABLE transactions (
    id TEXT NOT NULL PRIMARY KEY,
    positionId TEXT NOT NULL,
    dateYear INTEGER NOT NULL,
    dateMonth INTEGER NOT NULL,
    dateDay INTEGER NOT NULL,
    side TEXT AS TradeSide NOT NULL,
    quantity REAL NOT NULL,
    unitPrice REAL NOT NULL,
    fee REAL NOT NULL DEFAULT 0.0,
    note TEXT,
    storage TEXT,
    addedByMemberId TEXT NOT NULL,
    syncState TEXT AS SyncState NOT NULL DEFAULT 'Synced',
    -- Esitleme alanlari; bkz. 2.sqm.
    updatedAt INTEGER NOT NULL DEFAULT 0,
    deletedAt INTEGER,
    -- AYNI GUN ICI SIRA; bkz. 8.sqm. rowid'e dayaniyordu ve duzenleme,
    -- esitleme ve geri yukleme satiri yerinden oynatinca sira bozuluyordu.
    createdAt INTEGER NOT NULL DEFAULT 0,
    -- BU KAYDIN HEDEF ATAMASINA KATKISI; bkz. 9.sqm. Silme ve duzenleme
    -- atamaya `-goalDelta` uygular. Olmadan silme atamaya hic dokunmuyor,
    -- duzenleme ise katkiyi ikinci kez uyguluyordu.
    goalId TEXT,
    goalDelta REAL NOT NULL DEFAULT 0.0,
    -- Pozisyon silinince defteri de gitmeli. DIKKAT: SQLite'ta yabanci anahtar
    -- zorlamasi varsayilan olarak KAPALIDIR; surucu her baglantida
    -- "PRAGMA foreign_keys = ON" calistirmazsa bu satir hicbir sey yapmaz.
    FOREIGN KEY(positionId) REFERENCES positions(id) ON DELETE CASCADE
);

-- Her yazmada pozisyonun tum defteri okunuyor; indekssiz bu tam tarama olurdu.
CREATE INDEX transactions_positionId ON transactions(positionId);

-- Yeniden siralamayi ekran yapiyor (AssetDetailViewModel), buradaki sira yalniz
-- belirlilik icin: en yeni ustte.
selectAllTransactions:
SELECT *
FROM transactions
WHERE deletedAt IS NULL
ORDER BY dateYear DESC, dateMonth DESC, dateDay DESC, id;

-- Bir varligin defteri - KRONOLOJIK, eskiden yeniye.
--
-- TEK SORGU. Once ikisi vardi: biri ekran icin (tarih DESC, id), biri hesap
-- icin. costBasis() defteri kararli siralar, yani AYNI TARIHLI kayitlar
-- geldikleri sirada islenir; ekran sorgusunda o sira UUID sirasidir ve ayni gun
-- once alip sonra satan kullanicinin SATISI alistan once gelebiliyordu.
-- costBasis satis dalinda elde miktar bulamayip kaydi tumden atliyor, satis
-- hesaptan dusuyordu.
--
-- Kural depo tarafinda dogru uygulanmisti ama varlik detayi ekrani yanlis
-- sorguyu cagirmaya devam ediyordu: liste ekrani ile detay ekrani ayni defterden
-- FARKLI rakam gosteriyordu. Iki sorgudan biri tuzak oldugu surece bu yeniden
-- olur - o yuzden ekran sorgusu KALDIRILDI. Gorunum sirasini ekran kendi
-- siralayarak kurar (bkz. AssetDetailViewModel).
--
-- Ayni gun ici sira `createdAt`ten gelir, rowid'den DEGIL: rowid duzenlemede,
-- esitlemede ve geri yuklemede yeniden atanıyor ve sirayi bozuyordu (bkz.
-- 8.sqm). `id` son bag cozucu - iki kaydin damgasi esitse bile butun cihazlar
-- ayni siralamayi uretsin.
selectTransactionsByPosition:
SELECT *
FROM transactions
WHERE positionId = :positionId
AND deletedAt IS NULL
ORDER BY dateYear ASC, dateMonth ASC, dateDay ASC, createdAt ASC, id ASC;

-- En buyuk olusturulma damgasi - yeni kayit bunun BIR USTUNU alir.
--
-- Damga duz `nowEpochMillis()` olamaz: ayni milisaniyede yazilan iki kayit
-- esitlenir, sira `id` bagina yani UUID'ye duser ve tam kacinmaya calistigimiz
-- hata geri gelir. Ustelik duzenlemede eski damgayi devretmek de ise yaramaz -
-- devredilen deger baska bir kayitla esitse sira yine belirsizdir.
selectMaxTransactionCreatedAt:
SELECT MAX(createdAt) FROM transactions;

selectTransactionById:
SELECT *
FROM transactions
WHERE id = :id AND deletedAt IS NULL;

countTransactions:
SELECT count(*)
FROM transactions
WHERE deletedAt IS NULL;

-- Push: son esitlemeden beri degisenler. deletedAt FILTRELENMEZ - silinen kayit
-- da (mezar tasi) sunucuya gitmeli ki es cihaz onu dusursun.
selectTransactionsChangedSince:
SELECT *
FROM transactions
WHERE updatedAt >= :since
ORDER BY updatedAt;

-- Pull IKI ADIM. OR REPLACE satiri silip yeniden ekliyordu; satir yeni bir
-- rowid aliyor ve `createdAt` de ustune yaziliyordu, yani cekilen her guncelleme
-- kaydin ayni gun icindeki yerini degistiriyordu (bkz. 8.sqm).
--
-- `createdAt` sunucudan GELIR ve yalniz ilk goruste yazilir; sonraki
-- guncellemeler ona DOKUNMAZ - olusturulma sirasi bir daha degismemeli.
-- Sunucu 0 dondururse (kolon eklenmeden once yazilmis satir) cagiran
-- updatedAt'e duser: butun cihazlarda ayni deger oldugu icin siralama yine
-- ayni cikar.
--
-- syncState 'Synced': cekilen satir zaten sunucuda, yerelde "gonderilecek"
-- degil. LWW karari (yeni mi) cagiran tarafta yapilir.
insertOrIgnoreTransactionPull:
INSERT OR IGNORE INTO transactions(id, positionId, dateYear, dateMonth, dateDay, side, quantity, unitPrice, fee, note, storage, addedByMemberId, syncState, updatedAt, deletedAt, createdAt, goalId, goalDelta)
VALUES (:id, :positionId, :dateYear, :dateMonth, :dateDay, :side, :quantity, :unitPrice, :fee, :note, :storage, :addedByMemberId, 'Synced', :updatedAt, :deletedAt, :createdAt, :goalId, :goalDelta);

applyTransactionMetaPull:
UPDATE transactions
SET positionId = :positionId,
    dateYear = :dateYear,
    dateMonth = :dateMonth,
    dateDay = :dateDay,
    side = :side,
    quantity = :quantity,
    unitPrice = :unitPrice,
    fee = :fee,
    note = :note,
    storage = :storage,
    addedByMemberId = :addedByMemberId,
    syncState = 'Synced',
    updatedAt = :updatedAt,
    deletedAt = :deletedAt,
    goalId = :goalId,
    goalDelta = :goalDelta
WHERE id = :id;

-- Kimlik artik UUID (bkz. 7.1): iceriginden turetilmiyor, dolayisiyla ayni gun
-- ayni miktarda ikinci alim kendi satirini alir. Duz INSERT bilerek: "OR REPLACE"
-- bir cakismada kullanicinin islemini sessizce ezerdi.
insertTransaction:
INSERT INTO transactions(id, positionId, dateYear, dateMonth, dateDay, side, quantity, unitPrice, fee, note, storage, addedByMemberId, syncState, updatedAt, createdAt, goalId, goalDelta)
VALUES (:id, :positionId, :dateYear, :dateMonth, :dateDay, :side, :quantity, :unitPrice, :fee, :note, :storage, :addedByMemberId, :syncState, :updatedAt, :createdAt, :goalId, :goalDelta);

updateTransaction:
UPDATE transactions
SET positionId = :positionId,
    dateYear = :dateYear,
    dateMonth = :dateMonth,
    dateDay = :dateDay,
    side = :side,
    quantity = :quantity,
    unitPrice = :unitPrice,
    fee = :fee,
    note = :note,
    storage = :storage,
    addedByMemberId = :addedByMemberId,
    syncState = :syncState,
    updatedAt = :updatedAt
WHERE id = :id;

-- SILME BIR YAZMADIR: satir yerinde kalir, deletedAt doldurulur. Hard delete
-- cogaltilamaz - es cevrimdisiyken silinen kayit, o dondugunde geri dirilirdi.
deleteTransactionById:
UPDATE transactions
SET deletedAt = :deletedAt, updatedAt = :deletedAt
WHERE id = :id;

-- Pozisyon silinirken CASCADE zaten calisir; bu sorgu pragma foreign_keys kapali
-- kalirsa diye acik yol birakir.
deleteTransactionsByPosition:
UPDATE transactions
SET deletedAt = :deletedAt, updatedAt = :deletedAt
WHERE positionId = :positionId AND deletedAt IS NULL;

deleteAllTransactions:
DELETE FROM transactions;
