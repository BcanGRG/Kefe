-- Varlik -> hedef atamasi.
--
-- AYRI TABLO, pozisyonda kolon degil. Uc sebep:
--   1. positions tablosuna dokunmadan eklenir; defterle birlikte en cok yazilan
--      tablo o.
--   2. Iki yonlu ON DELETE CASCADE: hedef silinince atamalar duser, varlik
--      silinince de. Kolon olsaydi hedef silindiginde pozisyonlarda oksuz
--      kimlikler kalirdi.
--   3. positionId PRIMARY KEY oldugu icin "bir varlik en fazla bir hedefe"
--      kurali SEMADA durur, kodun hatirlamasi gereken bir sey degil.
--
-- BOLME (11 ceyregin 10'u Ev'e) VAR: `quantity`.
--
-- Once atama tam varliktiydi ve pratikte su oluyordu: Ev hedefinde 10 ceyrek
-- varken 1 tane "hedefsiz" eklemek, seciciyi Hedefsiz'e aldigi icin atamayi
-- komple siliyor ve 11 ceyregin HEPSI Ev'den cikiyordu. Kullanicinin
-- bekledigi "10'u Ev'de kalsin" ancak miktar tasiyan bir atamayla anlatilabilir.
--
-- quantity = -1 : TUM VARLIK (eski davranis). Mevcut satirlar boyle kalir ve
--   hedef detayindaki "Varlik sec" listesi de boyle atar - o ekranin sozu
--   "bu varligin tamami bu hedefi karsilar".
-- quantity >= 0 : o kadar adet/gram bu hedefe sayilir.
--
-- Miktar POZISYONUN MIKTARIYLA SINIRLANIR (bkz. goalWealth): 10 atanmisken 6
-- tanesi satilirsa hedef 6 sayar. Boylece satista ayri bir defter tutmaya
-- gerek kalmaz - kirpma okuma aninda yapilir.
CREATE TABLE goal_assets (
    positionId TEXT NOT NULL PRIMARY KEY REFERENCES positions(id) ON DELETE CASCADE,
    goalId TEXT NOT NULL REFERENCES goals(id) ON DELETE CASCADE,
    quantity REAL NOT NULL DEFAULT -1.0,
    updatedAt INTEGER NOT NULL DEFAULT 0,
    deletedAt INTEGER
);

CREATE INDEX goal_assets_goal ON goal_assets(goalId);

selectGoalAssets:
SELECT *
FROM goal_assets
WHERE deletedAt IS NULL;

-- Yerel degisim tetikleyicisi.
countGoalAssets:
SELECT count(*)
FROM goal_assets;

-- Push: son esitlemeden beri degisenler (mezar tasi dahil).
selectGoalAssetsChangedSince:
SELECT *
FROM goal_assets
WHERE updatedAt >= :since
ORDER BY updatedAt;

-- Pull: sunucudan gelen atama. goal_assets bir YAPRAK, OR REPLACE guvenli.
applyGoalAssetPull:
INSERT OR REPLACE INTO goal_assets(positionId, goalId, quantity, updatedAt, deletedAt)
VALUES (:positionId, :goalId, :quantity, :updatedAt, :deletedAt);

assignPositionToGoal:
INSERT OR REPLACE INTO goal_assets(positionId, goalId, quantity, updatedAt, deletedAt)
VALUES (:positionId, :goalId, :quantity, :updatedAt, NULL);

-- Tek satir - "bu varligin mevcut atamasi ne" sorusunun kayit anindaki cevabi.
selectGoalAssetByPosition:
SELECT *
FROM goal_assets
WHERE positionId = :positionId AND deletedAt IS NULL;

clearPositionAssignment:
UPDATE goal_assets
SET deletedAt = :deletedAt, updatedAt = :deletedAt
WHERE positionId = :positionId;

-- Hedef silinince ATAMALARI da mezar taslanir.
--
-- CASCADE burada calismaz: hedef silme YUMUSAKTIR (deletedAt doldurulur), satir
-- tabloda kalir. Atama satiri diri kaldigi icin yedege giriyor ama hedefin
-- kendisi yedege girmiyordu (selectGoals deletedAt IS NULL filtreliyor); geri
-- yuklemede oksuz atama FOREIGN KEY hatasi atiyor ve TUM geri yukleme geri
-- aliniyordu - kullanicinin yedegi kullanilamaz hale geliyordu.
clearGoalAssignments:
UPDATE goal_assets
SET deletedAt = :deletedAt, updatedAt = :deletedAt
WHERE goalId = :goalId AND deletedAt IS NULL;
