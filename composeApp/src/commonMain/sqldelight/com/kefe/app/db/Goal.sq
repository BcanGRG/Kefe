import com.kefe.app.domain.model.GoalAllocation;
import com.kefe.app.domain.model.GoalStatus;
import com.kefe.app.domain.model.GoalUnit;
import kotlin.Boolean;

-- Hedefler.
--
-- Goal.order kolon adi olarak kullanilamaz ("order" ayrilmis kelime) - sortOrder.
--
-- Tarihler yil/ay/gun ucluleri: KefeDate'in epochDay'den geri donusumu yok.
-- estimatedArrival NULLABLE oldugu icin uc kolonu da NULL olabilir; okurken
-- ucu de doluysa KefeDate kurulmali. INTEGER kolonlar Kotlin'de Long doner -
-- toInt() gerekir.
--
-- GoalMilestone burada YOK: yuzde duraklari hedef tutarindan hesaplanan gorunum
-- verisi, saklanacak bir sey degil.
CREATE TABLE goals (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    iconKey TEXT NOT NULL,
    amount REAL NOT NULL,
    unit TEXT AS GoalUnit NOT NULL,
    targetYear INTEGER NOT NULL,
    targetMonth INTEGER NOT NULL,
    targetDay INTEGER NOT NULL,
    monthlyContribution REAL NOT NULL,
    isMain INTEGER AS Boolean NOT NULL DEFAULT 0,
    allocation TEXT AS GoalAllocation NOT NULL DEFAULT 'AllWealth',
    status TEXT AS GoalStatus NOT NULL DEFAULT 'Active',
    sortOrder INTEGER NOT NULL DEFAULT 0,
    estimatedYear INTEGER,
    estimatedMonth INTEGER,
    estimatedDay INTEGER,
    -- Esitleme alanlari; bkz. 2.sqm.
    updatedAt INTEGER NOT NULL DEFAULT 0,
    deletedAt INTEGER
);

-- observeGoals() siralamayi VAAT EDIYOR - sira SQL'de kalmali, ekranda degil.
selectGoals:
SELECT *
FROM goals
WHERE deletedAt IS NULL
ORDER BY sortOrder, name;

selectGoalById:
SELECT *
FROM goals
WHERE id = :id AND deletedAt IS NULL;

countGoals:
SELECT count(*)
FROM goals
WHERE deletedAt IS NULL;

-- Push: son esitlemeden beri degisenler (mezar tasi dahil).
selectGoalsChangedSince:
SELECT *
FROM goals
WHERE updatedAt >= :since
ORDER BY updatedAt;

-- Pull: sunucudan gelen hedef. goals'ta OR REPLACE KULLANILMAZ - goal_assets
-- goalId'ye CASCADE bagli, silinip yeniden yazilinca atamalar ucar. Iki adim.
insertOrIgnoreGoalPull:
INSERT OR IGNORE INTO goals(id, name, iconKey, amount, unit, targetYear, targetMonth, targetDay, monthlyContribution, isMain, allocation, status, sortOrder, updatedAt)
VALUES (:id, :name, :iconKey, :amount, :unit, :targetYear, :targetMonth, :targetDay, :monthlyContribution, :isMain, :allocation, :status, :sortOrder, :updatedAt);

applyGoalMetaPull:
UPDATE goals
SET name = :name,
    iconKey = :iconKey,
    amount = :amount,
    unit = :unit,
    targetYear = :targetYear,
    targetMonth = :targetMonth,
    targetDay = :targetDay,
    monthlyContribution = :monthlyContribution,
    isMain = :isMain,
    allocation = :allocation,
    status = :status,
    sortOrder = :sortOrder,
    updatedAt = :updatedAt,
    deletedAt = :deletedAt
WHERE id = :id;

-- Hedefin cocuk tablosu yok; REPLACE burada guvenli (silinecek bagli satir yok).
upsertGoal:
INSERT OR REPLACE INTO goals(id, name, iconKey, amount, unit, targetYear, targetMonth, targetDay, monthlyContribution, isMain, allocation, status, sortOrder, estimatedYear, estimatedMonth, estimatedDay, updatedAt)
VALUES (:id, :name, :iconKey, :amount, :unit, :targetYear, :targetMonth, :targetDay, :monthlyContribution, :isMain, :allocation, :status, :sortOrder, :estimatedYear, :estimatedMonth, :estimatedDay, :updatedAt);

-- reorderGoals: verilen kimlik listesi tek transaction icinde indeksleriyle
-- yazilir. Listede olmayan hedefler sortOrder'ini korur. updatedAt bumped:
-- yoksa yeniden siralama push'ta gorunmez.
updateGoalOrder:
UPDATE goals
SET sortOrder = :sortOrder, updatedAt = :updatedAt
WHERE id = :id;

-- Ana hedef tektir: yenisi isaretlenmeden once digerleri temizlenir.
clearMainGoalFlag:
UPDATE goals
SET isMain = 0;

updateGoalStatus:
UPDATE goals
SET status = :status
WHERE id = :id;

deleteGoalById:
UPDATE goals
SET deletedAt = :deletedAt, updatedAt = :deletedAt
WHERE id = :id;

deleteAllGoals:
DELETE FROM goals;
