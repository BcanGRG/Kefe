import com.kefe.app.domain.model.GoalStatus;
import com.kefe.app.domain.model.GoalUnit;
import kotlin.Boolean;

-- Hedefler.
--
-- Goal.order kolon adi olarak kullanilamaz ("order" ayrilmis kelime) - sortOrder.
--
-- Tarihler yil/ay/gun ucluleri: KefeDate'in epochDay'den geri donusumu yok.
-- INTEGER kolonlar Kotlin'de Long doner - toInt() gerekir.
--
-- allocation ve estimated* ESKI KOLONLAR: artik hicbir sorgu yazmiyor, hicbir
-- kod okumuyor. Tabloda birakildilar cunku SQLite'ta kolon dusurmek tabloyu
-- yeniden kurmak demek - veri tasiyan bir tabloda gereksiz risk. Varsayilanlari
-- var, INSERT'ler onlari atlayabiliyor.
--
-- GoalMilestone burada YOK: yuzde duraklari hedef tutarindan hesaplanan gorunum
-- verisi, saklanacak bir sey degil.
CREATE TABLE goals (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    iconKey TEXT NOT NULL,
    amount REAL NOT NULL,
    unit TEXT AS GoalUnit NOT NULL,
    targetYear INTEGER NOT NULL,
    targetMonth INTEGER NOT NULL,
    targetDay INTEGER NOT NULL,
    monthlyContribution REAL NOT NULL,
    isMain INTEGER AS Boolean NOT NULL DEFAULT 0,
    allocation TEXT NOT NULL DEFAULT 'AllWealth',
    status TEXT AS GoalStatus NOT NULL DEFAULT 'Active',
    sortOrder INTEGER NOT NULL DEFAULT 0,
    estimatedYear INTEGER,
    estimatedMonth INTEGER,
    estimatedDay INTEGER,
    -- Esitleme alanlari; bkz. 2.sqm.
    updatedAt INTEGER NOT NULL DEFAULT 0,
    deletedAt INTEGER,
    -- Canli kur hedefi ve harcanan hedef; bkz. 13.sqm. DUZ METIN/SAYI: eski bir
    -- surum bilinmeyen bir enum degerinde (EnumColumnAdapter) cokerdi.
    anchorUnit TEXT,
    anchorAmount REAL,
    spentAt INTEGER,
    -- Aylik katki hedefin biriminde (bkz. 14.sqm); null = TL.
    contributionAnchor REAL
);

-- observeGoals() siralamayi VAAT EDIYOR - sira SQL'de kalmali, ekranda degil.
selectGoals:
SELECT *
FROM goals
WHERE deletedAt IS NULL
ORDER BY sortOrder, name;

selectGoalById:
SELECT *
FROM goals
WHERE id = :id AND deletedAt IS NULL;

countGoals:
SELECT count(*)
FROM goals
WHERE deletedAt IS NULL;

-- Push: son esitlemeden beri degisenler (mezar tasi dahil).
selectGoalsChangedSince:
SELECT *
FROM goals
WHERE updatedAt >= :since
ORDER BY updatedAt;

-- Pull: sunucudan gelen hedef. goals'ta OR REPLACE KULLANILMAZ - goal_assets
-- goalId'ye CASCADE bagli, silinip yeniden yazilinca atamalar ucar. Iki adim.
insertOrIgnoreGoalPull:
INSERT OR IGNORE INTO goals(id, name, iconKey, amount, unit, targetYear, targetMonth, targetDay, monthlyContribution, isMain, status, sortOrder, updatedAt, anchorUnit, anchorAmount, spentAt, contributionAnchor)
VALUES (:id, :name, :iconKey, :amount, :unit, :targetYear, :targetMonth, :targetDay, :monthlyContribution, :isMain, :status, :sortOrder, :updatedAt, :anchorUnit, :anchorAmount, :spentAt, :contributionAnchor);

applyGoalMetaPull:
UPDATE goals
SET name = :name,
    iconKey = :iconKey,
    amount = :amount,
    unit = :unit,
    targetYear = :targetYear,
    targetMonth = :targetMonth,
    targetDay = :targetDay,
    monthlyContribution = :monthlyContribution,
    isMain = :isMain,
    status = :status,
    sortOrder = :sortOrder,
    anchorUnit = :anchorUnit,
    anchorAmount = :anchorAmount,
    spentAt = :spentAt,
    contributionAnchor = :contributionAnchor,
    updatedAt = :updatedAt,
    deletedAt = :deletedAt
WHERE id = :id;

-- Yerel yazma: hedefi duzenleyip kaydetme, tamamlandi isaretleme, ana hedefi
-- degistirme ve yedekten geri yukleme buradan gecer. Pull yolu gibi IKI ADIM.
--
-- Burada bir zamanlar tek bir INSERT OR REPLACE ve ustunde "Hedefin cocuk
-- tablosu yok; REPLACE burada guvenli" yaziyordu. Yanlisti: goal_assets.goalId
-- bu tabloya ON DELETE CASCADE bagli. REPLACE catisan satiri once SILDIGI icin
-- hedefi her kaydetme o hedefin BUTUN varlik atamalarini sessizce goturuyor,
-- goalWealth() atama bulamayip 0 donuyor ve ilerleme %0'a dusuyordu.
--
-- Kural yukaridaki pull yolunda zaten dogru yazilmisti; eksik olan onu yerel
-- yola da uygulamakti.
insertOrIgnoreGoal:
INSERT OR IGNORE INTO goals(id, name, iconKey, amount, unit, targetYear, targetMonth, targetDay, monthlyContribution, isMain, status, sortOrder, updatedAt, anchorUnit, anchorAmount, spentAt, contributionAnchor)
VALUES (:id, :name, :iconKey, :amount, :unit, :targetYear, :targetMonth, :targetDay, :monthlyContribution, :isMain, :status, :sortOrder, :updatedAt, :anchorUnit, :anchorAmount, :spentAt, :contributionAnchor);

-- deletedAt NULL'lanir: REPLACE satiri sifirdan yazdigi icin zaten oyle
-- davraniyordu ve "kullanici bu hedefi kaydediyor" demek onu diri tutmak demek.
applyGoalMeta:
UPDATE goals
SET name = :name,
    iconKey = :iconKey,
    amount = :amount,
    unit = :unit,
    targetYear = :targetYear,
    targetMonth = :targetMonth,
    targetDay = :targetDay,
    monthlyContribution = :monthlyContribution,
    isMain = :isMain,
    status = :status,
    sortOrder = :sortOrder,
    anchorUnit = :anchorUnit,
    anchorAmount = :anchorAmount,
    spentAt = :spentAt,
    contributionAnchor = :contributionAnchor,
    updatedAt = :updatedAt,
    deletedAt = NULL
WHERE id = :id;

-- reorderGoals: verilen kimlik listesi tek transaction icinde indeksleriyle
-- yazilir. Listede olmayan hedefler sortOrder'ini korur. updatedAt bumped:
-- yoksa yeniden siralama push'ta gorunmez.
updateGoalOrder:
UPDATE goals
SET sortOrder = :sortOrder, updatedAt = :updatedAt
WHERE id = :id;

-- Ana hedef tektir: yenisi isaretlenmeden once digerleri temizlenir.
clearMainGoalFlag:
UPDATE goals
SET isMain = 0;

-- "Birleştir": ana hedef TEK kalir, hesabinki. Cihazdaki diger ana hedefler
-- isaretini birakir; damga yenilenir ki degisiklik hesaba da gitsin.
clearMainGoalExcept:
UPDATE goals
SET isMain = 0, updatedAt = :updatedAt
WHERE isMain = 1 AND id != :keepId AND deletedAt IS NULL;

-- Hesabin ana hedefi yerelde (LWW'de yerel kopya daha yeni kaldiysa)
-- isaretsizse isaretlenir; zaten isaretliyse satira dokunulmaz.
markMainGoal:
UPDATE goals
SET isMain = 1, updatedAt = :updatedAt
WHERE id = :id AND isMain = 0 AND deletedAt IS NULL;

updateGoalStatus:
UPDATE goals
SET status = :status
WHERE id = :id;

deleteGoalById:
UPDATE goals
SET deletedAt = :deletedAt, updatedAt = :deletedAt
WHERE id = :id;

deleteAllGoals:
DELETE FROM goals;
