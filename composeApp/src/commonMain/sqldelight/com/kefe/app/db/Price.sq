import com.kefe.app.domain.model.AssetClass;
import com.kefe.app.domain.model.PriceSource;

-- Kaynaktan cekilen son fiyatlar - CEVRIMDISI ACILIS icin onbellek.
--
-- Yalniz uzak fiyatlar buraya yazilir; elle girilen degerler ayri tabloda
-- (manual_prices) durur ve okurken bunlarin uzerine bindirilir. Ikisi ayni
-- tabloda olsaydi bir yenileme elle girilen degeri ezerdi - fiyat sozlesmesinin
-- tam tersi.
--
-- Price.isManual kolon DEGIL: bindirme sirasinda uretilen gorunum bayragi.
--
-- timestamp kaynaktan gelen serbest metin ("14:32", "dun 21:30") - sirf ekranda
-- gosterilir. Tazelik hesabi (2 saatten eski = Stale) o metinden yapilamaz,
-- bu yuzden fetchedAtEpochSeconds ayri tutulur.
CREATE TABLE cached_prices (
    assetKey TEXT NOT NULL PRIMARY KEY,
    label TEXT NOT NULL,
    bid REAL,
    ask REAL NOT NULL,
    changePercent REAL NOT NULL,
    timestamp TEXT NOT NULL,
    source TEXT AS PriceSource NOT NULL,
    assetClass TEXT AS AssetClass NOT NULL,
    fetchedAtEpochSeconds INTEGER NOT NULL DEFAULT 0,
    -- Kaynagin KENDI para birimindeki fiyat - yalniz gosterim icin.
    -- Hesap TL ile yapilir (bkz. 6.sqm); bu cift, "₺14.690" satirinin altina
    -- "$308,91" yazabilmek icin duruyor. Altin/doviz/fon ve TL borsasindaki
    -- hissede NULL: onlarda zaten TL disinda bir fiyat yok.
    nativePrice REAL,
    nativeCurrency TEXT,
    -- Kotasyonun ait oldugu islem gunu (yyyymmdd). NULL = bilmiyoruz ve
    -- "bugun degil" sayilir; gunluk degisime katkisi sifir olur (bkz. 7.sqm).
    quoteDateKey INTEGER
);

-- Elle girilen fiyatlar. Kalici olmasi ZORUNLU: "elle girilen deger otomatik
-- yenilemede ezilmez" sozu, harita bellekte tutuldugu surece uygulama her
-- kapandiginda cokuyordu.
CREATE TABLE manual_prices (
    assetKey TEXT NOT NULL PRIMARY KEY,
    price REAL NOT NULL,
    updatedAtEpochSeconds INTEGER NOT NULL DEFAULT 0
);

-- Varlik basina GUNLUK fiyat gecmisi - Varlik Detayi grafiginin kaynagi.
--
-- cached_prices her yenilemede uzerine yazilir, gecmis tutmaz. Grafik bu yuzden
-- uydurma bir egri ciziyordu: sabit bir bicim guncel fiyatla olceklenip "12
-- aylik gecmis" diye gosteriliyordu. Bugun alinan bir varlikta bile bir yillik
-- yukselis gorunuyordu.
--
-- Gunde tek satir; gun icindeki yenilemeler satiri tazeler. Gecmis bir gunun
-- fiyati sonradan ogrenilemez - o gun yazilmazsa kayiptir, net deger
-- fotograflariyla ayni kural.
CREATE TABLE price_history (
    assetKey TEXT NOT NULL,
    dateYear INTEGER NOT NULL,
    dateMonth INTEGER NOT NULL,
    dateDay INTEGER NOT NULL,
    price REAL NOT NULL,
    PRIMARY KEY (assetKey, dateYear, dateMonth, dateDay)
);

-- --- Fiyat gecmisi ---------------------------------------------------------

selectPriceHistory:
SELECT *
FROM price_history
WHERE assetKey = :assetKey
ORDER BY dateYear, dateMonth, dateDay;

-- Haftalik/aylik degisimin kaynagi: TUM varliklarin son N gunu.
--
-- Tarih uc kolona bolundugu icin karsilastirilabilir tek bir sayiya cevrilir
-- (yyyymmdd). Tablonun tamamini okumak yil gectikce buyuyen bir sorgu olurdu;
-- aylik degisim icin ~40 gun yeter.
selectRecentPriceHistory:
SELECT *
FROM price_history
WHERE (dateYear * 10000 + dateMonth * 100 + dateDay) >= :sinceDateKey
ORDER BY assetKey, dateYear, dateMonth, dateDay;

upsertPriceHistory:
INSERT OR REPLACE INTO price_history(assetKey, dateYear, dateMonth, dateDay, price)
VALUES (:assetKey, :dateYear, :dateMonth, :dateDay, :price);

deleteAllPriceHistory:
DELETE FROM price_history;

-- Cok eski gunleri atar. Boyut sorunu DEGIL, emniyet sinir: gercek cihazda
-- olculdu, satir basi ~80 bayt (indeks dahil) ve 19 varlik x 1 yil = 0,53 MB.
-- On yil bile 5 MB. Yine de sinirsiz buyuyen bir tablo birakmiyoruz; portfoyden
-- cikarilan bir fonun anahtari da boylece zamanla dusuyor.
deletePriceHistoryBefore:
DELETE FROM price_history
WHERE (dateYear * 10000 + dateMonth * 100 + dateDay) < :beforeDateKey;

-- --- Onbellek --------------------------------------------------------------

selectCachedPrices:
SELECT *
FROM cached_prices;

selectCachedPrice:
SELECT *
FROM cached_prices
WHERE assetKey = :assetKey;

-- Tazelik serit rengi bu degerden hesaplanir (2 saat esigi).
selectLastFetchedAt:
SELECT max(fetchedAtEpochSeconds)
FROM cached_prices;

-- Bagli tablo yok, REPLACE guvenli.
upsertCachedPrice:
INSERT OR REPLACE INTO cached_prices(assetKey, label, bid, ask, changePercent, timestamp, source, assetClass, fetchedAtEpochSeconds, nativePrice, nativeCurrency, quoteDateKey)
VALUES (:assetKey, :label, :bid, :ask, :changePercent, :timestamp, :source, :assetClass, :fetchedAtEpochSeconds, :nativePrice, :nativeCurrency, :quoteDateKey);

deleteCachedPrice:
DELETE FROM cached_prices
WHERE assetKey = :assetKey;

-- Artik TUTULMAYAN fon/hisse kotasyonlarini onbellekten duser.
--
-- Altin, gumus, doviz ve nakit tahtada HER ZAMAN durur: onlar piyasanin
-- standart kalemleri, tutuluyor olmalari gerekmiyor. Fon ve hisse satirlari
-- ise yalnizca kullanici o araci tuttugu icin var - hangi kodlarin cekilecegi
-- de portfoyden turuyor (bkz. selectHeldFundIds/selectHeldStockIds). Varlik
-- silinince ya da tamami satilinca kotasyonun tahtada kalmasi icin bir sebep
-- kalmiyor; Piyasa listesi elde olmayan bir sembolu gostermeye devam ediyordu.
--
-- Kosul selectHeldFundIds'in TERSIDIR ve ayni olcuyu kullanir: miktar sifirsa
-- ya da satir silinmisse tutulmuyor demektir. Kimlik sozlesmesi
-- "pos_<anahtar>" (bkz. Position.priceKey).
--
-- Elle girilen fiyata DOKUNULMAZ: o kullanicinin verisi, kaynaktan yeniden
-- uretilemez. Onbellek satiri gidince zaten tahtada satir kalmiyor - elle
-- fiyat mevcut satirin uzerine binen bir katman, kendi basina satir acmiyor.
deleteUnheldInstrumentPrices:
DELETE FROM cached_prices
WHERE (assetKey LIKE 'fund\_%' ESCAPE '\' OR assetKey LIKE 'stock\_%' ESCAPE '\')
AND NOT EXISTS (
    SELECT 1 FROM positions
    WHERE positions.id = 'pos_' || cached_prices.assetKey
    AND positions.quantity > 0.0
    AND positions.deletedAt IS NULL
);

deleteAllCachedPrices:
DELETE FROM cached_prices;

-- --- Elle fiyatlar ---------------------------------------------------------

selectManualPrices:
SELECT *
FROM manual_prices;

selectManualPrice:
SELECT *
FROM manual_prices
WHERE assetKey = :assetKey;

upsertManualPrice:
INSERT OR REPLACE INTO manual_prices(assetKey, price, updatedAtEpochSeconds)
VALUES (:assetKey, :price, :updatedAtEpochSeconds);

-- clearManualPrice: elle girilen deger yalniz buradan silinir, yenileme silmez.
deleteManualPrice:
DELETE FROM manual_prices
WHERE assetKey = :assetKey;

deleteAllManualPrices:
DELETE FROM manual_prices;
