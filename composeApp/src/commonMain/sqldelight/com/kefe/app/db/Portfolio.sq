
-- Portfoy ve uyeleri.
--
-- Portfolio.memberIds ayri bir ara tablo olarak DEGIL, uyenin uzerindeki
-- portfolioId ile tutulur: uygulama tek portfoyle calisiyor ve hicbir yazma
-- yolu bir uyeyi ikinci portfoye baglamiyor. Ara tablo bugun yalniz REPLACE
-- tuzagi ve fazladan join getirirdi.
CREATE TABLE portfolios (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    currency TEXT NOT NULL
);

-- lastSeen serbest metin ("2 saat once goruldu") - tarih degil, ekran metni.
-- Gercek zaman damgasi gerektiginde ayri bir kolon eklenmeli, bu kolon
-- yorumlanmamali.
CREATE TABLE members (
    id TEXT NOT NULL PRIMARY KEY,
    portfolioId TEXT NOT NULL,
    name TEXT NOT NULL,
    initials TEXT NOT NULL,
    -- role/permission: cok kullanicili modelden kalma. Kolonlar YERINDE durur
    -- (SQLite 3.18 DROP COLUMN desteklemiyor) ama artik sabit yazilir, okunmaz.
    role TEXT NOT NULL,
    permission TEXT NOT NULL,
    lastSeen TEXT NOT NULL,
    -- Portfolio.memberIds bir LISTE; sirasi ekranda avatar sirasini belirledigi
    -- icin saklanmali.
    sortOrder INTEGER NOT NULL DEFAULT 0,
    -- Esitleme: yeniden adlandirmada son yazan kazanir; bkz. 4.sqm. Mezar tasi
    -- yok - iki profil sabittir, silinmez.
    updatedAt INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY(portfolioId) REFERENCES portfolios(id) ON DELETE CASCADE
);

-- --- Portfoy ---------------------------------------------------------------

selectPortfolio:
SELECT *
FROM portfolios
LIMIT 1;

countPortfolios:
SELECT count(*)
FROM portfolios;

-- Portfoyun cocuklari var (members). INSERT OR REPLACE satiri once SILECEGI icin
-- ON DELETE CASCADE tetiklenir ve uyeler ucar; bu yuzden ekleme/guncelleme iki
-- adima bolundu. Cagiran taraf ikisini tek transaction icinde calistirmali.
insertOrIgnorePortfolio:
INSERT OR IGNORE INTO portfolios(id, name, currency)
VALUES (:id, :name, :currency);

updatePortfolio:
UPDATE portfolios
SET name = :name,
    currency = :currency
WHERE id = :id;

deleteAllPortfolios:
DELETE FROM portfolios;

-- --- Uyeler ----------------------------------------------------------------

selectMembers:
SELECT *
FROM members
ORDER BY sortOrder, name;

-- Yerel degisim tetikleyicisi bu sayaci dinler: yazma olunca push istenir.
countMembers:
SELECT count(*)
FROM members;

-- Push: son esitlemeden beri degisenler. Mezar tasi yok (uye silinmez), ama
-- filtre digerleriyle ayni bicimde tutulur.
selectMembersChangedSince:
SELECT *
FROM members
WHERE updatedAt >= :since
ORDER BY updatedAt;

-- Pull: sunucudan gelen profil adi/sirasi. Uyeler bootstrap'ta zaten kuruldu
-- (sabit id), o yuzden yalniz guncelleme yeter; mezar tasi yok.
applyMemberPull:
UPDATE members
SET name = :name, initials = :initials, sortOrder = :sortOrder, updatedAt = :updatedAt
WHERE id = :id;

selectMemberById:
SELECT *
FROM members
WHERE id = :id;

-- Portfolio.memberIds bu sorgudan kurulur.
selectMemberIds:
SELECT id
FROM members
WHERE portfolioId = :portfolioId
ORDER BY sortOrder, name;

insertOrIgnoreMember:
INSERT OR IGNORE INTO members(id, portfolioId, name, initials, role, permission, lastSeen, sortOrder)
VALUES (:id, :portfolioId, :name, :initials, 'Owner', 'CanEdit', '', :sortOrder);

-- Yalniz ad ve bas harf. sortOrder korunur: profil kurulumu yalniz ismi
-- degistirir, satirin geri kalanina dokunmamali. updatedAt bumped: yoksa yeniden
-- adlandirma push'ta "degismemis" sayilir ve ese gitmez.
renameMember:
UPDATE members
SET name = :name, initials = :initials, updatedAt = :updatedAt
WHERE id = :id;

deleteMemberById:
DELETE FROM members
WHERE id = :id;

deleteAllMembers:
DELETE FROM members;
